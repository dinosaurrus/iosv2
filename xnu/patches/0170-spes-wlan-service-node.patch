+/*
+ * The device tree's "wlan" node. A platform that publishes nodes as nubs (HackiOS) has a
+ * service of that name; spes does not, and the node itself is looked up in the device tree.
+ * Retained.
+ */
+static IORegistryEntry *
+wlanNode(void)
+{
+	OSDictionary * match = IOService::nameMatching("wlan");
+	IOService * service = match != NULL ? IOService::copyMatchingService(match) : NULL;
+	OSIterator * found;
+	IORegistryEntry * node = NULL;
+
+	OSSafeReleaseNULL(match);
+	if (service != NULL) {
+		return service;
+	}
+	found = IODTFindMatchingEntries(IORegistryEntry::getRegistryRoot(), kIODTRecursive, "('wlan')");
+	if (found != NULL) {
+		node = (IORegistryEntry *) found->getNextObject();
+		if (node != NULL) {
+			node->retain();         /* (the iterator's set lets go of it) */
+		}
+		found->release();
+	}
+	return node;
+}
