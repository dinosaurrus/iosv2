 /* ---------------------------------------------------------------- GLINK RX */
 
+/*
+ * The lengths in a GLINK message are the modem's: in 32 bits, 8 + p2 (or 16 + chunk) wraps to
+ * zero for a value near 4 GB, rx_advance(0) leaves the message in the FIFO and every pass reads
+ * it again. 64-bit sums, and a message that cannot fit the FIFO stops the link instead.
+ */
+static bool
+rx_fits(uint64_t length)
+{
+	if (length > g_rx_len) {
+		LOG("t=%u ms: glink: a message of %llu bytes in a %u-byte FIFO: RX stopped", g_ms, length, g_rx_len);
+		g_rx = NULL;
+		return false;
+	}
+	return true;
+}
